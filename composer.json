{
    "name": "socranext/statamic",
    "description": "Get found in AI. Connect your Statamic website to SocraNext.",
    "type": "statamic-addon",
    "license": "proprietary",
    "homepage": "https://socranext.ai/",
    "keywords": ["statamic", "socranext", "cms", "faq", "articles", "seo", "integration"],
    "authors": [{ "name": "SocraNext", "homepage": "https://socranext.ai/" }],
    "support": {
        "email": "info@socranext.ai",
        "source": "https://github.com/SocraNext/socranext-statamic",
        "issues": "https://github.com/SocraNext/socranext-statamic/issues",
        "docs": "https://github.com/SocraNext/socranext-statamic#readme"
    },
    "require": {
        "php": "^8.3",
        "ext-sodium": "*",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": { "psr-4": { "SocraNext\\Statamic\\": "src/" } },
    "autoload-dev": { "psr-4": { "SocraNext\\Statamic\\Tests\\": "tests/" } },
    "extra": {
        "laravel": { "providers": ["SocraNext\\Statamic\\ServiceProvider"] },
        "statamic": { "name": "SocraNext", "description": "Articles, FAQs and publishing through your SocraNext workspace." }
    },
    "scripts": { "test": "phpunit" },
    "config": { "sort-packages": true, "allow-plugins": false },
    "minimum-stability": "stable",
    "prefer-stable": true
}
